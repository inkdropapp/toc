    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "remark-toc": "^9.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "inkdrop": "^6.0.0"
  }
